  <!--
    SOLIDWORKS PDM interop assembly, proprietary to Dassault Systemes SolidWorks Corporation.
    The build references the copy of a local PDM client installation; at runtime the add-in binds
    to the copy every PDM client already has. Both flags below keep it out of what we ship:
    EmbedInteropTypes False compiles none of its type definitions into GladosPdmAddin.dll, and
    Private False keeps the DLL out of bin\, so it can never be uploaded with the add-in by
    mistake. Do not change either flag (Visual Studio's reference properties make that easy).
  -->
  <ItemGroup>
    <Reference Include="EPDM.Interop.epdm">
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS PDM\EPDM.Interop.epdm.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
